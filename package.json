{
  "name": "picture-frame-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "NYC wall dashboard (weather, subway, Citi Bike, Google Calendar) for a rooted AiMOR PF1007 photo frame",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "demo": "DEMO=1 node server/index.js",
    "test": "node --test test/*.test.js",
    "find-station": "node scripts/find-citibike-station.js",
    "find-stop": "node scripts/find-subway-stop.js"
  },
  "dependencies": {
    "gtfs-realtime-bindings": "^2.2.0",
    "rrule": "^2.8.1"
  }
}
