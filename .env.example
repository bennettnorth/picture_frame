# Google Calendar -> Settings -> (your calendar) -> Integrate calendar ->
# "Secret address in iCal format". Treat it like a password.
GCAL_FAMILY_ICS=https://calendar.google.com/calendar/ical/xxxxxxxx/private-xxxxxxxx/basic.ics

# Optional locally (Render generates one): require ?key=<value> to read dashboard data.
# DASHBOARD_KEY=some-long-random-string
