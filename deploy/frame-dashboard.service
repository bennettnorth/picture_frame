# systemd unit for a Raspberry Pi / Linux box on your home network.
#   sudo cp deploy/frame-dashboard.service /etc/systemd/system/
#   sudo systemctl enable --now frame-dashboard
[Unit]
Description=Photo frame dashboard
After=network-online.target
Wants=network-online.target

[Service]
# Change these to where you cloned the repo and the user that owns it.
WorkingDirectory=/home/pi/picture_frame
User=pi
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
